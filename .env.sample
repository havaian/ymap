# Development Environment Configuration
# Copy this file to .env for local development

PROJECT_NAME=ymap

FRONTEND_EXPOSE=127.0.0.1:7797
FRONTEND_DEV_PORT=7797
FRONTEND_PROD_PORT=80

# Public address of the Nuxt frontend. Confirmation links in letters point here.
PUBLIC_BASE_URL=http://localhost:7797

# SMTP for account confirmation. Optional: with SMTP_HOST empty the backend prints
# the confirmation link to its log and registration still completes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Y.Map <no-reply@ymap.ytech.space>
VERIFY_TOKEN_TTL_MS=86400000
VERIFY_RESEND_COOLDOWN_MS=60000
# Password reset links are live credentials, so they expire faster than
# confirmation links: one hour by default against twenty-four.
RESET_TOKEN_TTL_MS=3600000

# Адреса обратной связи, попадают в подвал сайта. Пустое значение допустимо:
# иконка остаётся, ссылка ведёт в "#". Голый адрес почты сам превращается в mailto.
NUXT_PUBLIC_CONTACT_TELEGRAM=
NUXT_PUBLIC_CONTACT_CHAT=
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_CONTACT_SITE=
